# 请复制为 .env 并填入自己的密钥，不能提交真实 .env。
MAIN_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 若不使用智谱，清空 REVIEWER_MODEL，独立复核模型回退到 deepseek-flash。
REVIEWER_MODEL=glm-5.3-flash
REVIEWER_MODEL_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
DATABASE_URL=sqlite:///./data/agent.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
STORE_DB_PATH=./data/store.db
FRONTEND_ORIGIN=http://127.0.0.1:5173
SSE_QUEUE_SIZE=32
SSE_HEARTBEAT_SECONDS=10
LOG_LEVEL=INFO
# Langfuse SDK 5.2.0：需要 Langfuse v4 或兼容的 Cloud 项目。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=local-dev
# 默认不导出输入/输出正文；开启前确认数据外发范围。
LANGFUSE_CAPTURE_CONTENT=false
